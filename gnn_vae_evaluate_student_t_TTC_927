import time
import argparse
import joblib
import numpy as np
import pandas as pd
import torch
import pyro

from gnn_vae_student_t_TTC_927 import (
    MatrixGNN_VAE,
    process_raw_data,
    num_segment,
    LATENT_DIM,
)

# ==========================================
# CONFIG
# ==========================================
PARAMS_PATH  = "2025_Jan_Jun_vae_student-t_TTC_927.pt"
SCALER_PATH  = "y_scaler_vae_student-t_2025_Jan_Jun_TTC_927.pkl"
DATA_PATH    = "trip_info_9_section_ver2_simplify_ultra_no_variance_2025_Jul_Dec.xlsx"
HIDDEN_DIM   = 64    # 請確保與訓練時一致 (若為 13 或其他數值可於參數傳入)
MC_SAMPLES   = 100   # Monte Carlo 抽樣次數
INFER_BATCH  = 512   # 批次大小


# ==========================================
# 1. LOAD MODEL
# ==========================================
def load_model(params_path, device, hidden_dim=HIDDEN_DIM):
    pyro.clear_param_store()

    bnn_model = MatrixGNN_VAE(
        num_sections=num_segment,
        global_dim=9,
        local_dim=4,
        hidden_dim=hidden_dim,
        latent_dim=LATENT_DIM,
        device=device,
    ).to(device)

    print(f"Loading weights from '{params_path}'...")
    try:
        state_dict = torch.load(params_path, map_location=device)
        bnn_model.load_state_dict(state_dict)
        print("✓ Successfully loaded via PyTorch state_dict.")
    except Exception:
        pyro.get_param_store().load(params_path, map_location=device)
        print("✓ Successfully loaded via Pyro param_store.")

    bnn_model.eval()
    return bnn_model


# ==========================================
# 2. FAST BATCHED INFERENCE
# ==========================================
def run_inference_fast(x_global_val, x_local_val, y_raw_all,
                       bnn_model, scaler_y, device):
    n = x_global_val.shape[0]

    all_pred_means = np.zeros(n, dtype=np.float32)
    all_pred_stds  = np.zeros(n, dtype=np.float32)
    all_pred_dfs   = np.zeros(n, dtype=np.float32)

    print(f"\nRunning batched inference (n={n}, MC={MC_SAMPLES}, batch={INFER_BATCH})...")
    t0 = time.time()

    for start in range(0, n, INFER_BATCH):
        end     = min(start + INFER_BATCH, n)
        batch_g = x_global_val[start:end]   # [B, 9]
        batch_l = x_local_val[start:end]    # [B, 9, 4]
        b_size  = end - start

        with torch.no_grad():
            # 1. Encoder 取樣潛在變數
            mu, logvar = bnn_model.encoder(batch_g, batch_l)
            sigma = torch.exp(0.5 * logvar)

            # 2. Monte Carlo 取樣潛在變數 z: [MC_SAMPLES, B, LATENT_DIM]
            eps = torch.randn(MC_SAMPLES, b_size, LATENT_DIM, device=device)
            z   = mu.unsqueeze(0) + eps * sigma.unsqueeze(0)

            # 攤平平行解碼
            z_flat = z.view(-1, LATENT_DIM)
            a_e_flat, b_t_flat, df_t_flat = bnn_model.decoder(z_flat)

            a_e  = a_e_flat.view(MC_SAMPLES, b_size)
            b_t  = b_t_flat.view(MC_SAMPLES, b_size)
            df_t = df_t_flat.view(MC_SAMPLES, b_size)

            # 3. 從 Student-t 觀測分佈中採樣
            obs_dist = torch.distributions.StudentT(
                df=df_t,
                loc=a_e,
                scale=b_t
            )
            samples = obs_dist.sample()  # [MC, B]

            all_pred_means[start:end] = samples.mean(dim=0).cpu().numpy()
            all_pred_stds[start:end]  = samples.std(dim=0).cpu().numpy()
            all_pred_dfs[start:end]   = df_t.mean(dim=0).cpu().numpy()

    elapsed = time.time() - t0
    print(f"Inference completed in {elapsed:.1f}s ({n/elapsed:.0f} trips/s)")

    # ── 模型預測值：透過 Jan_Jun Scaler 逆轉換回真實秒數 ──
    pred_real   = scaler_y.inverse_transform(all_pred_means.reshape(-1, 1)).squeeze(-1)
    
    # ── 真實值：直接使用原始真實秒數（徹底避開標籤逆轉誤差） ──
    actual_real = y_raw_all
    
    # ── 不確定性尺度 ──
    std_real    = all_pred_stds * scaler_y.scale_[0]

    # ── 逐筆診斷印出與統計 ──
    _print_detailed_diagnostics(pred_real, actual_real, std_real, all_pred_dfs, n)


# ==========================================
# 3. DETAILED DIAGNOSTIC PRINT OUT
# ==========================================
def _print_detailed_diagnostics(pred_real, actual_real, std_real, dfs, n):
    within_bound_count = 0
    error_total = 0.0
    error_abs_total = 0.0
    error_sq_total = 0.0
    mape_total = 0.0

    list_of_predict = []
    list_of_confidence = []
    list_of_actual  = []

    print("\n" + "="*60)
    print("--- Starting Detailed Trip-by-Trip Diagnostic ---")
    print("="*60)

    for j in range(n):
        pred_j   = pred_real[j]
        actual_j = actual_real[j]
        std_j    = std_real[j]
        df_j     = dfs[j]

        within = (pred_j - std_j) <= actual_j <= (pred_j + std_j)
        if within:
            within_bound_count += 1

        # 累積誤差計算
        err = actual_j - pred_j
        abs_err = abs(err)
        sq_err = err ** 2
        pct_err = abs_err / max(actual_j, 1e-6) * 100.0

        error_total += err
        error_abs_total += abs_err
        error_sq_total += sq_err
        mape_total += pct_err

        list_of_predict.append(pred_j)
        list_of_confidence.append(std_j)
        list_of_actual.append(actual_j)

        # 當前累積統計
        current_mae  = error_abs_total / (j + 1)
        current_mape = mape_total / (j + 1)
        current_rmse = np.sqrt(error_sq_total / (j + 1))
        current_bias = error_total / (j + 1)

        pred_std_so_far = np.std(list_of_predict)
        conf_std_so_far = np.std(list_of_confidence)
        act_std_so_far  = np.std(list_of_actual)

        # 逐筆印出診斷
        print(f"\n--- Sample {j} ---")
        print(f"Total ETA: {pred_j:.2f}s  (Actual: {actual_j:.2f}s)")
        print(f"Confidence: ±{std_j:.2f}s (Estimated df: {df_j:.1f}) | Within CI? {'YES' if within else 'NO'}")
        print(f"MAE so far: {current_mae:.2f}s | MAPE so far: {current_mape:.2f}% | RMSE so far: {current_rmse:.2f}s | Bias: {current_bias:.2f}s")
        print(f"Prediction Std Deviation: {pred_std_so_far:.2f} , Confidence Std Deviation: {conf_std_so_far:.2f} , Actual Std Deviation: {act_std_so_far:.2f}")
        print(f"總共 {j+1} 筆，{within_bound_count} 筆落在區間內")

    # ==========================================
    # FINAL SUMMARY REPORT
    # ==========================================
    final_mae  = error_abs_total / n
    final_mape = mape_total / n
    final_rmse = np.sqrt(error_sq_total / n)
    final_bias = error_total / n
    coverage   = (within_bound_count / n) * 100.0
    mean_ci_ratio = np.mean(pred_real / np.where(std_real > 0, std_real, 1))

    print("\n" + "="*60)
    print(f"SUMMARY  ({n} trips, {MC_SAMPLES} MC samples)")
    print("="*60)
    print(f"  Trip-level within CI (±1σ) : {within_bound_count}/{n} ({coverage:.1f}%)")
    print(f"  Final MAE                  : {final_mae:.2f}s")
    print(f"  Final MAPE                 : {final_mape:.2f}%")
    print(f"  Final RMSE                 : {final_rmse:.2f}s")
    print(f"  Final Bias                 : {final_bias:.2f}s")
    print(f"  Average Estimated df (ν)   : {dfs.mean():.2f}")
    print(f"  CI ratio (mean p/σ)        : {mean_ci_ratio:.3f}")
    print(f"  Overall Prediction Std     : {np.std(list_of_predict):.2f}s")
    print(f"  Overall Actual Std         : {np.std(list_of_actual):.2f}s")
    print("="*60)


# ==========================================
# 4. MAIN ENTRY
# ==========================================
if __name__ == "__main__":
    parser = argparse.ArgumentParser()
    parser.add_argument("--params",     default=PARAMS_PATH, help="Path to .pt model weights")
    parser.add_argument("--scaler",     default=SCALER_PATH, help="Path to scaler .pkl")
    parser.add_argument("--data",       default=DATA_PATH,   help="Path to evaluation Excel file")
    parser.add_argument("--hidden_dim", type=int, default=HIDDEN_DIM)
    parser.add_argument("--batch",      type=int, default=INFER_BATCH)
    parser.add_argument("--mc",         type=int, default=MC_SAMPLES)
    parser.add_argument("--cpu",        action="store_true")
    args = parser.parse_args()

    INFER_BATCH = args.batch
    MC_SAMPLES  = args.mc

    device = torch.device("cpu" if args.cpu else ("cuda" if torch.cuda.is_available() else "cpu"))
    print(f"Device : {device}")
    if device.type == "cuda":
        print(f"GPU    : {torch.cuda.get_device_name(0)}")

    scaler_y = joblib.load(args.scaler)
    print(f"Scaler : '{args.scaler}'")

    # 讀取測試集資料 (接收 5 個返回值，取得未縮放的 y_raw_all)
    x_global_all, x_local_all, y_all, y_raw_all, _ = process_raw_data(args.data)
    x_global_val = x_global_all.to(device)
    x_local_val  = x_local_all.to(device)

    # 載入模型
    bnn_model = load_model(args.params, device, hidden_dim=args.hidden_dim)

    # 執行批次推論 (將 y_raw_all 作為真實基準傳入)
    run_inference_fast(x_global_val, x_local_val, y_raw_all, bnn_model, scaler_y, device)