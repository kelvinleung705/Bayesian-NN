# 3. 資料讀取與模型加載
# ==========================================
def load_eval_data_with_raw_y(file_path):
    print(f"正在讀取評估資料: {file_path}...")
    if file_path.endswith('.csv'):
        df = pd.read_csv(file_path, header=None, skiprows=1)
    else:
        df = pd.read_excel(file_path, header=None, skiprows=1)

    end = 9 + NUM_SEGMENT + 1 + (NUM_SEGMENT * 4) + 2
    df_subset = df.iloc[:, 0:end].dropna()
    df_subset = df_subset.apply(pd.to_numeric, errors='coerce').dropna()

    raw_data_np = df_subset.values.astype(np.float32)

    x_global = torch.tensor(raw_data_np[:, 0:9], dtype=torch.float32)
    raw_local = raw_data_np[:, 9 + NUM_SEGMENT + 1 : 9 + NUM_SEGMENT + 1 + (NUM_SEGMENT * 4)]
    x_local = torch.tensor(raw_local.reshape(-1, NUM_SEGMENT, 4), dtype=torch.float32)

    # 取得真實秒數 y_raw
    y_raw = raw_data_np[:, 9 : 9 + NUM_SEGMENT].sum(axis=1)

    print(f"加載筆數: {raw_data_np.shape[0]} | y_raw 平均值: {y_raw.mean():.2f}s | y_raw 標準差: {y_raw.std():.2f}s")
    return x_global, x_local, y_raw


def load_model(params_path, device):
    print("正在初始化 Student-t VAE 模型...")
    bnn_model = MatrixGNN_VAE(
        num_sections=NUM_SEGMENT,
        global_dim=GLOBAL_DIM,
        local_dim=LOCAL_DIM,
        hidden_dim=HIDDEN_DIM,
        latent_dim=LATENT_DIM
    ).to(device)

    print(f"正在載入權重: {params_path}...")
    state_dict = torch.load(params_path, map_location=device)
    bnn_model.load_state_dict(state_dict)
    bnn_model.eval()
    return bnn_model


def enable_mc_dropout(model):
    """啟用 Dropout 以結合 Epistemic Uncertainty (可選)"""
    for m in model.modules():
        if m.__class__.__name__.startswith('Dropout'):
            m.train()


# ==========================================
# 4. Student-t 專屬批次推論
# ==========================================
def run_inference_fast(x_global_val, x_local_val, y_raw, bnn_model, scaler_y, device, mc_samples=200, batch_size=512, use_mc_dropout=True):
    n = x_global_val.shape[0]

    pred_means = np.zeros(n, dtype=np.float32)
    pred_stds  = np.zeros(n, dtype=np.float32)
    pred_dfs   = np.zeros(n, dtype=np.float32)

    print(f"\n開始執行批次推論 (總樣本數={n}, MC取樣數={mc_samples}, 批次大小={batch_size})...")
    t0 = time.time()

    bnn_model.eval()
    if use_mc_dropout:
        enable_mc_dropout(bnn_model)

    with torch.no_grad():
        for start in range(0, n, batch_size):
            end     = min(start + batch_size, n)
            batch_g = x_global_val[start:end]
            batch_l = x_local_val[start:end]

            mc_locs   = []
            mc_scales = []
            mc_dfs    = []

            # 蒙地卡羅取樣（採樣 z ~ q(z|x) 與 dropout）
            for _ in range(mc_samples):
                loc, scale, df, _ = bnn_model(batch_g, batch_l, force_sample=True)
                mc_locs.append(loc.squeeze(-1))
                mc_scales.append(scale.squeeze(-1))
                mc_dfs.append(df.squeeze(-1))

            mc_locs   = torch.stack(mc_locs)    # [MC, Batch]
            mc_scales = torch.stack(mc_scales)  # [MC, Batch]
            mc_dfs    = torch.stack(mc_dfs)     # [MC, Batch]

            # 1. 預測期望值 (ETA 平均值)
            final_eta = mc_locs.mean(dim=0)

            # 2. 認識不確定性 (Epistemic Variance: Var(E[Y|z]))
            epistemic_var = mc_locs.var(dim=0)

            # 3. 偶然不確定性 (Student-t Aleatoric Variance: E[Var(Y|z)])
            # 對於 Student-t(nu, loc, scale)，Var = scale^2 * (nu / (nu - 2))
            student_t_sample_vars = (mc_scales ** 2) * (mc_dfs / (mc_dfs - 2.0).clamp(min=1e-4))
            aleatoric_var = student_t_sample_vars.mean(dim=0)

            # 4. 總不確定性標準差 (總變異數開根號)
            total_std = torch.sqrt(epistemic_var + aleatoric_var)

            pred_means[start:end] = final_eta.cpu().numpy()
            pred_stds[start:end]  = total_std.cpu().numpy()
            pred_dfs[start:end]   = mc_dfs.mean(dim=0).cpu().numpy()

            elapsed = time.time() - t0
            rate    = end / elapsed if elapsed > 0 else 0
            eta_rem = (n - end) / rate if rate > 0 else 0
            print(f"  進度: {end:5d}/{n}  |  速度: {rate:.0f} trips/s  |  剩餘時間: {eta_rem:.1f}s", end='\r', flush=True)

    elapsed = time.time() - t0
    print(f"\n推論完成！總耗時: {elapsed:.2f}s")

    # 反標準化為真實秒數空間
    pred_real   = scaler_y.inverse_transform(pred_means.reshape(-1, 1)).squeeze(-1)
    std_real    = pred_stds * scaler_y.scale_[0]
    actual_real = y_raw

    _print_results(pred_real, actual_real, std_real, pred_dfs, n, mc_samples)


# ==========================================
# 5. 成果報表輸出
# ==========================================
def _print_results(pred_real, actual_real, std_real, pred_dfs, n, mc_samples):
    trip_within = ((actual_real >= pred_real - std_real) &
                   (actual_real <= pred_real + std_real))

    num_samples_to_show = min(n, 5)
    print("\n" + "="*70)
    print(f"  前 {num_samples_to_show} 筆個別推論抽樣展示")
    print("="*70)
    for j in range(num_samples_to_show):
        print(f"--- 樣本 {j+1} ---")
        print(f"  預測 ETA    : {pred_real[j]:.1f}s (真實值: {actual_real[j]:.1f}s)")
        print(f"  信賴區間    : ±{std_real[j]:.1f}s | 落在區間內? {'YES' if trip_within[j] else 'NO'}")
        print(f"  動態自由度  : ν = {pred_dfs[j]:.2f}")
        print(f"  當前 MAE    : {np.abs(pred_real[:j+1] - actual_real[:j+1]).mean():.1f}s | "
              f"偏差 Bias: {(pred_real[:j+1] - actual_real[:j+1]).mean():.1f}s")

    print(f"\n... (其餘 {n - num_samples_to_show} 筆已省略，直接印出全局指標) ...")

    mae  = mean_absolute_error(actual_real, pred_real)
    mape = mean_absolute_percentage_error(actual_real, pred_real) * 100
    rmse = np.sqrt(mean_squared_error(actual_real, pred_real))
    bias = (pred_real - actual_real).mean()
    cov  = trip_within.mean() * 100

    print("\n" + "="*70)
    print(f"SUMMARY REPORT  ({n} trips | {mc_samples} MC samples | Student-t)")
    print("="*70)
    print(f"  信賴區間覆蓋率 (Within CI) : {trip_within.sum()}/{n} ({cov:.2f}%) [理論目標: 68.3%]")
    print(f"  平均學到的尾部自由度 (ν)   : {np.mean(pred_dfs):.2f}")
    print(f"  平均絕對誤差 (MAE)         : {mae:.2f} s")
    print(f"  平均絕對百分比誤差 (MAPE)  : {mape:.2f} %")
    print(f"  均方根誤差 (RMSE)          : {rmse:.2f} s")
    print(f"  整體預測偏差 (Bias)        : {bias:.2f} s (正=高估, 負=低估)")
    print(f"  預測值標準差 (Pred Std)    : {np.std(pred_real):.2f} s")
    print(f"  不確定性半寬平均 (Mean CI) : {np.mean(std_real):.2f} s")
    print(f"  真實值標準差 (Actual Std)  : {np.std(actual_real):.2f} s")
    print("="*70)


