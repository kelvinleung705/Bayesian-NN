# 6. 命令列執行入口
# ==========================================
if __name__ == "__main__":
    parser = argparse.ArgumentParser(description="Student-t MatrixGNN-VAE 推論評估腳本")
    parser.add_argument("--params",  default=PARAMS_PATH, help="模型權重路徑 (.pt)")
    parser.add_argument("--scaler",  default=SCALER_PATH, help="Scaler 物件路徑 (.pkl)")
    parser.add_argument("--data",    default=DATA_PATH,   help="測試集 Excel/CSV 路徑")
    parser.add_argument("--batch",   type=int, default=INFER_BATCH, help="推論 Batch 大小")
    parser.add_argument("--mc",      type=int, default=MC_SAMPLES, help="蒙地卡羅取樣次數")
    parser.add_argument("--no-dropout", action="store_true", help="關閉 MC-Dropout (只依賴 VAE 瓶頸採樣)")
    parser.add_argument("--cpu",     action="store_true", help="強制使用 CPU 推論")
    args = parser.parse_args()

    device = torch.device("cpu" if args.cpu else ("cuda" if torch.cuda.is_available() else "cpu"))
    print(f"執行硬體裝置: {device}")
    if device.type == 'cuda':
        print(f"GPU 型號: {torch.cuda.get_device_name(0)}")

    scaler_y = joblib.load(args.scaler)
    print(f"成功載入 Scaler: '{args.scaler}'")

    x_global_all, x_local_all, y_raw = load_eval_data_with_raw_y(args.data)
    x_global_val = x_global_all.to(device)
    x_local_val  = x_local_all.to(device)

    model = load_model(args.params, device)
    run_inference_fast(
        x_global_val, 
        x_local_val, 
        y_raw, 
        model, 
        scaler_y, 
        device, 
        mc_samples=args.mc, 
        batch_size=args.batch,
        use_mc_dropout=(not args.no_dropout)
    )