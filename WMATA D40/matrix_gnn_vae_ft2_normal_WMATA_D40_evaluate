import statistics
import time
import argparse
import numpy as np
import pandas as pd
import torch
import joblib
from sklearn.metrics import mean_absolute_error, mean_absolute_percentage_error, mean_squared_error

# 匯入你的模型類別與常數
from matrix_gnn_vae_ft2_normal import (
    MatrixGNN_VAE,
    num_segment,
    LATENT_DIM,
)

# ==========================================
# 1. CONFIG 設定
# ==========================================
PARAMS_PATH  = "2025_Jul_Dec_vae_ft_normal_TTC_927.pt"
SCALER_PATH  = "y_scaler_vae_normal_2025_Jul_Dec_TTC_927.pkl"
DATA_PATH    = "trip_info_9_section_ver2_simplify_ultra_no_variance_2026_Jan_Jun.xlsx"
HIDDEN_DIM   = 64    # ft 版本為 64
MC_SAMPLES   = 200   # 蒙地卡羅取樣次數
INFER_BATCH  = 512   # 批次大小


# ==========================================
# 2. 直接讀取 y_raw 的資料加載函數
# ==========================================
def load_eval_data_with_raw_y(file_path):
    """直接讀取特徵，並直接加總出真實秒數 y_raw，不經過 Scaler"""
    print(f"正在讀取資料集: {file_path}...")
    if file_path.endswith('.csv'):
        df = pd.read_csv(file_path, header=None, skiprows=1)
    else:
        df = pd.read_excel(file_path, header=None, skiprows=1)

    end = 9 + num_segment + 1 + (num_segment * 4) + 2
    df_subset = df.iloc[:, 0:end].dropna()
    df_subset = df_subset.apply(pd.to_numeric, errors='coerce').dropna()

    raw_data_np = df_subset.values.astype(np.float32)

    x_global = torch.tensor(raw_data_np[:, 0:9], dtype=torch.float32)
    raw_local = raw_data_np[:, 9+num_segment+1:9+num_segment+1+(num_segment*4)]
    x_local = torch.tensor(raw_local.reshape(-1, num_segment, 4), dtype=torch.float32)

    # 直接計算全趟真實總秒數 y_raw
    y_raw = raw_data_np[:, 9 : 9+num_segment].sum(axis=1)

    print(f"總共加載 {raw_data_np.shape[0]} 筆樣本")
    print(f"y_raw 平均值: {y_raw.mean():.2f}s | 標準差: {y_raw.std():.2f}s")
    return x_global, x_local, y_raw


# ==========================================
# 3. 載入模型 (PyTorch State Dict)
# ==========================================
def load_model(params_path, device):
    print("正在初始化 ft 模型架構...")
    bnn_model = MatrixGNN_VAE(
        num_sections=num_segment,
        global_dim=9,
        local_dim=4,
        hidden_dim=HIDDEN_DIM,
        latent_dim=LATENT_DIM,
        device=device,
    ).to(device)

    print(f"正在載入權重: {params_path}...")
    state_dict = torch.load(params_path, map_location=device)
    bnn_model.load_state_dict(state_dict)
    bnn_model.eval()
    return bnn_model


def enable_mc_dropout(model):
    """啟用 Dropout 以進行 Epistemic 不確定性估算"""
    for m in model.modules():
        if m.__class__.__name__.startswith('Dropout'):
            m.train()


# ==========================================
# 4. 極速批次推論
# ==========================================
def run_inference_fast(x_global_val, x_local_val, y_raw, bnn_model, scaler_y, device):
    n = x_global_val.shape[0]

    pred_means = np.zeros(n, dtype=np.float32)
    pred_stds  = np.zeros(n, dtype=np.float32)
    pred_dfs   = np.zeros(n, dtype=np.float32)

    print(f"\n開始執行批次推論 (n={n}, MC={MC_SAMPLES}, Batch={INFER_BATCH})...")
    t0 = time.time()

    bnn_model.eval()
    enable_mc_dropout(bnn_model)

    with torch.no_grad():
        for start in range(0, n, INFER_BATCH):
            end     = min(start + INFER_BATCH, n)
            batch_g = x_global_val[start:end]
            batch_l = x_local_val[start:end]

            mc_predictions = []
            mc_aleatorics  = []
            mc_dfs         = []

            for _ in range(MC_SAMPLES):
                # ─── 修正 1：相容 3 或 4 個回傳值 ───
                outputs = bnn_model(batch_g, batch_l, force_sample=True)
                if len(outputs) == 4:
                    locs, scalers, dfs, _ = outputs
                else: 
                    locs, scalers, _ = outputs
                    dfs = None  # 代表當前是 Normal Likelihood，無 df

                mc_predictions.append(locs.squeeze(-1))
                mc_aleatorics.append(scalers.squeeze(-1))
                if dfs is not None:
                    mc_dfs.append(dfs.squeeze(-1))

            mc_predictions = torch.stack(mc_predictions) # [MC, Batch]
            mc_aleatorics  = torch.stack(mc_aleatorics)  # [MC, Batch]

            # 1. 點預測 (ETA 平均值)
            final_eta = mc_predictions.mean(dim=0)
            
            # 2. 認識不確定性 (Epistemic Variance)
            epistemic_var = mc_predictions.var(dim=0)
            
            # ─── 修正 2：根據分佈類型計算偶然不確定性 (Aleatoric) ───
            if len(mc_dfs) > 0:
                # Student-t 分佈
                mc_dfs = torch.stack(mc_dfs)
                student_t_vars = (mc_aleatorics ** 2) * (mc_dfs / (mc_dfs - 2.0).clamp(min=1e-4))
                aleatoric_var = student_t_vars.mean(dim=0)
                mean_df = mc_dfs.mean(dim=0).cpu().numpy()
            else:
                # 常態分佈（Normal Likelihood）：Var = sigma^2
                aleatoric_var = (mc_aleatorics ** 2).mean(dim=0)
                mean_df = np.full(end - start, np.nan) # 標記為無 df
            
            # 3. 總標準差 (總不確定性 CI 半寬)
            total_std = torch.sqrt(epistemic_var + aleatoric_var)

            pred_means[start:end] = final_eta.cpu().numpy()
            pred_stds[start:end]  = total_std.cpu().numpy()
            pred_dfs[start:end]   = mean_df

            elapsed = time.time() - t0
            rate    = end / elapsed if elapsed > 0 else 0
            eta     = (n - end) / rate if rate > 0 else 0
            print(f"  進度: {end:5d}/{n}  |  速度: {rate:.0f} trips/s  |  剩餘時間: {eta:.1f}s", end='\r', flush=True)

    elapsed = time.time() - t0
    print(f"\n推論完成！耗時: {elapsed:.1f}s")

    # 反標準化回真實秒數
    pred_real = scaler_y.inverse_transform(pred_means.reshape(-1, 1)).squeeze(-1)
    std_real  = pred_stds * scaler_y.scale_[0]
    actual_real = y_raw

    # 輸出報表
    _print_results(pred_real, actual_real, std_real, pred_dfs, n)


# ==========================================
# 5. 結果報表輸出
# ==========================================
def _print_results(pred_real, actual_real, std_real, pred_dfs, n):
    total_pred = pred_real
    total_act  = actual_real
    total_std  = std_real

    trip_within = ((total_act >= total_pred - total_std) &
                   (total_act <= total_pred + total_std))

    pred_running_std = [np.std(total_pred[: j + 1]) for j in range(n)]
    conf_running_std = [np.std(total_std[: j + 1]) for j in range(n)]
    act_running_std  = [np.std(total_act[: j + 1]) for j in range(n)]

    # ─── 修正 3：只印出前 5 筆，避免 7,312 次 print 造成終端機凍結 ───
    num_samples_to_show = min(n, 5)
    for j in range(num_samples_to_show):
        df_str = f"{pred_dfs[j]:.2f}" if not np.isnan(pred_dfs[j]) else "N/A (Gaussian)"
        print(f"\n--- Sample {j} ---")
        print(f"  Total ETA : {total_pred[j]:.1f}s  (Actual [y_raw]: {total_act[j]:.1f}s)")
        print(f"  Conf      : ±{total_std[j]:.1f}s  |  Within CI? {'YES' if trip_within[j] else 'NO'}")
        print(f"  Likelihood: df = {df_str}")
        print(f"  MAE so far: {np.abs(total_pred[:j+1] - total_act[:j+1]).mean():.1f}s  |  "
              f"Bias: {(total_pred[:j+1] - total_act[:j+1]).mean():.1f}s")
        print(f"  Prediction Std: {pred_running_std[j]:.2f} , "
              f"Conf Std: {conf_running_std[j]:.2f} , "
              f"Actual Std: {act_running_std[j]:.2f}")
        
    print(f"\n... (已省略中途 {n - num_samples_to_show} 筆輸出，直接呈現全局統計) ...")

    # 全局評估指標
    mae  = mean_absolute_error(total_act, total_pred)
    mape = mean_absolute_percentage_error(total_act, total_pred) * 100
    rmse = np.sqrt(mean_squared_error(total_act, total_pred))
    bias = (total_pred - total_act).mean()  # 正值表示平均高估，負值表示平均低估
    trip_cov = trip_within.mean() * 100

    print(f"\n{'='*60}")
    print(f"SUMMARY  ({n} trips, {MC_SAMPLES} MC samples)")
    print(" (Evaluated directly against ground-truth y_raw)")
    print(f"{'='*60}")
    print(f"  Trip-level within CI : {trip_within.sum()}/{n}  ({trip_cov:.1f}%) [理論目標: 68.3%]")
    if not np.isnan(pred_dfs).all():
        print(f"  Average df (tail)    : {np.nanmean(pred_dfs):.2f}")
    else:
        print(f"  Likelihood Type      : Gaussian / Normal (無 tail df)")
    print(f"  MAE                  : {mae:.2f} s")
    print(f"  MAPE                 : {mape:.2f} %")
    print(f"  RMSE                 : {rmse:.2f} s")
    print(f"  Bias                 : {bias:.2f} s (正=高估, 負=低估)")
    print(f"  Prediction Std       : {np.std(total_pred):.2f} s")
    print(f"  Confidence Std       : {np.std(total_std):.2f} s")
    print(f"  Actual Std           : {np.std(total_act):.2f} s")
    print(f"  CI ratio (mean p/σ)  : {(total_pred / np.where(total_std>0, total_std, 1)).mean():.3f}")


# ==========================================
# 6. MAIN
# ==========================================
if __name__ == "__main__":
    parser = argparse.ArgumentParser()
    parser.add_argument("--params",  default=PARAMS_PATH)
    parser.add_argument("--scaler",  default=SCALER_PATH)
    parser.add_argument("--data",    default=DATA_PATH)
    parser.add_argument("--batch",   type=int, default=INFER_BATCH)
    parser.add_argument("--mc",      type=int, default=MC_SAMPLES)
    parser.add_argument("--cpu",     action="store_true")
    args = parser.parse_args()

    INFER_BATCH = args.batch
    MC_SAMPLES  = args.mc

    device = torch.device("cpu" if args.cpu else ("cuda" if torch.cuda.is_available() else "cpu"))
    print(f"使用硬體裝置: {device}")
    if device.type == 'cuda':
        print(f"GPU: {torch.cuda.get_device_name(0)}")

    scaler_y = joblib.load(args.scaler)
    print(f"載入 Scaler: '{args.scaler}'")

    x_global_all, x_local_all, y_raw = load_eval_data_with_raw_y(args.data)
    x_global_val = x_global_all.to(device)
    x_local_val  = x_local_all.to(device)

    bnn_model = load_model(args.params, device)
    run_inference_fast(x_global_val, x_local_val, y_raw, bnn_model, scaler_y, device)