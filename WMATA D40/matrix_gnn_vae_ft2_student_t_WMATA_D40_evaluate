def load_eval_data_with_raw_y(file_path):
    print(f"正在讀取評估資料: {file_path}...")
    df = pd.read_csv(file_path, header=None, skiprows=1)

    end = 9 + NUM_SEGMENT + 1 + (NUM_SEGMENT * 4) + 2
    df_subset = df.iloc[:, 0:end].apply(pd.to_numeric, errors="coerce")

    # 確保完全去除含 NaN 的列
    df_subset = df_subset.dropna()

    raw_data_np = df_subset.values.astype(np.float32)
    x_global = torch.tensor(raw_data_np[:, 0:9], dtype=torch.float32)
    raw_local = raw_data_np[
        :, 9 + NUM_SEGMENT + 1 : 9 + NUM_SEGMENT + 1 + (NUM_SEGMENT * 4)
    ]
    x_local = torch.tensor(
        raw_local.reshape(-1, NUM_SEGMENT, 4), dtype=torch.float32
    )

    y_raw = raw_data_np[:, 9 : 9 + NUM_SEGMENT].sum(axis=1)

    # 【修正點 3】過濾目標值中潛在的 NaN 或 Inf
    valid_idx = np.isfinite(y_raw)
    if not np.all(valid_idx):
        print(f"⚠️ 警告: 移除包含 NaN/Inf 的標籤 {np.sum(~valid_idx)} 筆")
        x_global = x_global[valid_idx]
        x_local = x_local[valid_idx]
        y_raw = y_raw[valid_idx]

    print(
        f"加載筆數: {x_global.shape[0]} | y_raw 平均值: {y_raw.mean():.2f}s | y_raw 標準差: {y_raw.std():.2f}s"
    )
    return x_global, x_local, y_raw


def load_model(params_path, device):
    bnn_model = MatrixGNN_VAE().to(device)
    state_dict = torch.load(params_path, map_location=device)
    bnn_model.load_state_dict(state_dict)
    bnn_model.eval()
    return bnn_model


# ==========================================
# 批次推論
# ==========================================
def run_inference_fast(
    x_global_val,
    x_local_val,
    y_raw,
    bnn_model,
    scaler_y,
    device,
    mc_samples=200,
    batch_size=512,
    use_mc_dropout=False,
):
    n = x_global_val.shape[0]

    pred_means = np.zeros(n, dtype=np.float32)
    pred_stds = np.zeros(n, dtype=np.float32)
    pred_dfs = np.zeros(n, dtype=np.float32)

    print(
        f"\n開始執行批次推論 (總樣本數={n}, MC取樣數={mc_samples}, 批次大小={batch_size})..."
    )
    t0 = time.time()

    bnn_model.eval()
    if use_mc_dropout:
        for m in bnn_model.modules():
            if m.__class__.__name__.startswith("Dropout"):
                m.train()

    with torch.no_grad():
        for start in range(0, n, batch_size):
            end = min(start + batch_size, n)
            batch_g = x_global_val[start:end]
            batch_l = x_local_val[start:end]

            mc_locs = []
            mc_scales = []
            mc_dfs = []

            for _ in range(mc_samples):
                loc, scale, df = bnn_model(batch_g, batch_l, force_sample=True)
                mc_locs.append(loc.squeeze(-1))
                mc_scales.append(scale.squeeze(-1))
                mc_dfs.append(df.squeeze(-1))

            mc_locs = torch.stack(mc_locs)  # [MC, Batch]
            mc_scales = torch.stack(mc_scales)  # [MC, Batch]
            mc_dfs = torch.stack(mc_dfs)  # [MC, Batch]

            # 1. 預測期望值
            final_eta = mc_locs.mean(dim=0)

            # 2. Epistemic 不確定性
            epistemic_var = mc_locs.var(dim=0, unbiased=False)

            # 3. Student-t Aleatoric 不確定性
            # Var = scale^2 * (nu / (nu - 2.0))
            # 【修正點 4】加入 clamp 保護，防止分母接近 0
            safe_denom = torch.clamp(mc_dfs - 2.0, min=0.1)
            student_t_sample_vars = (mc_scales**2) * (mc_dfs / safe_denom)
            aleatoric_var = student_t_sample_vars.mean(dim=0)

            total_std = torch.sqrt(epistemic_var + aleatoric_var + 1e-6)

            pred_means[start:end] = final_eta.cpu().numpy()
            pred_stds[start:end] = total_std.cpu().numpy()
            pred_dfs[start:end] = mc_dfs.mean(dim=0).cpu().numpy()

            elapsed = time.time() - t0
            rate = end / elapsed if elapsed > 0 else 0
            print(
                f"  進度: {end:5d}/{n}  |  速度: {rate:.0f} trips/s",
                end="\r",
                flush=True,
            )

    elapsed = time.time() - t0
    print(f"\n推論完成！總耗時: {elapsed:.2f}s")

    # 反標準化
    pred_real = scaler_y.inverse_transform(pred_means.reshape(-1, 1)).squeeze(
        -1
    )
    std_real = pred_stds * scaler_y.scale_[0]
    actual_real = y_raw

    # 【修正點 5】雙重檢查確保無 NaN
    nan_mask = (
        np.isnan(pred_real)
        | np.isnan(actual_real)
        | np.isinf(pred_real)
        | np.isinf(actual_real)
    )
    if np.any(nan_mask):
        print(f"⚠️ 發現 {np.sum(nan_mask)} 筆 NaN/Inf，自動過濾以供計算指標")
        pred_real = pred_real[~nan_mask]
        actual_real = actual_real[~nan_mask]
        std_real = std_real[~nan_mask]
        pred_dfs = pred_dfs[~nan_mask]
        n = len(pred_real)

    _print_results(pred_real, actual_real, std_real, pred_dfs, n, mc_samples)


def _print_results(pred_real, actual_real, std_real, pred_dfs, n, mc_samples):
    trip_within = (actual_real >= pred_real - std_real) & (
        actual_real <= pred_real + std_real
    )
    num_samples_to_show = min(n, 5)

    print("\n" + "=" * 70)
    print(f"  前 {num_samples_to_show} 筆個別推論抽樣展示")
    print("=" * 70)
    for j in range(num_samples_to_show):
        print(f"--- 樣本 {j+1} ---")
        print(f"  預測 ETA    : {pred_real[j]:.1f}s (真實值: {actual_real[j]:.1f}s)")
        print(
            f"  信賴區間    : ±{std_real[j]:.1f}s | 落在區間內? {'YES' if trip_within[j] else 'NO'}"
        )
        print(f"  動態自由度  : ν = {pred_dfs[j]:.2f}")

    mae = mean_absolute_error(actual_real, pred_real)
    mape = mean_absolute_percentage_error(actual_real, pred_real) * 100
    rmse = np.sqrt(mean_squared_error(actual_real, pred_real))
    bias = (pred_real - actual_real).mean()
    cov = trip_within.mean() * 100

    print("\n" + "=" * 70)
    print(f"SUMMARY REPORT  ({n} trips | {mc_samples} MC samples | Student-t)")
    print("=" * 70)
    print(f"  信賴區間覆蓋率 (Within CI) : {cov:.2f}% [目標: 68.3%]")
    print(f"  平均學到的尾部自由度 (ν)   : {np.mean(pred_dfs):.2f}")
    print(f"  平均絕對誤差 (MAE)         : {mae:.2f} s")
    print(f"  平均絕對百分比誤差 (MAPE)  : {mape:.2f} %")
    print(f"  均方根誤差 (RMSE)          : {rmse:.2f} s")
    print(f"  整體預測偏差 (Bias)        : {bias:.2f} s")
    print("=" * 70)


if __name__ == "__main__":
    device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
    print(f"執行硬體裝置: {device}")

    scaler_y = joblib.load(SCALER_PATH)
    x_global_all, x_local_all, y_raw = load_eval_data_with_raw_y(DATA_PATH)

    x_global_val = x_global_all.to(device)
    x_local_val = x_local_all.to(device)

    model = load_model(PARAMS_PATH, device)

    # 預設將 use_mc_dropout 關閉，讓推論完全專注在 VAE 潛在空間的蒙地卡羅取樣
    run_inference_fast(
        x_global_val,
        x_local_val,
        y_raw,
        model,
        scaler_y,
        device,
        mc_samples=MC_SAMPLES,
        batch_size=INFER_BATCH,
        use_mc_dropout=False,
    )